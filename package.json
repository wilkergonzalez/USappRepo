{
  "name": "usapp-prototype",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "apps/admin"
  ],
  "scripts": {
    "mobile": "npm --prefix apps/mobile start",
    "mobile:web": "node scripts/start-mobile-web.mjs",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "admin": "node scripts/start-admin.mjs",
    "admin:lint": "npm --prefix apps/admin run lint",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:start": "npm --prefix apps/admin run start",
    "demo": "node scripts/local-demo.mjs",
    "test": "node --test tests/hardening.test.mjs tests/local-demo.test.mjs"
  }
}
