# Shared public Supabase settings
# Expo mobile reads EXPO_PUBLIC_* values; Next.js server code can read the unprefixed fallbacks below.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional redirect URLs for Supabase Auth email flows
EXPO_PUBLIC_APP_URL=http://localhost:8081
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional demo / preview notes
# When the Supabase variables are absent, both apps fall back to local demo data so the prototype still runs.
